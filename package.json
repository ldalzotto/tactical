{
  "name": "tactical",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "cmake -S . -B build && cmake --build build",
    "build:release": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build",
