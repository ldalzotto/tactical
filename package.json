{
  "name": "tactical",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node server/build.js",
    "build:verbose": "node server/build.js --verbose",
    "build:release": "node server/build.js --release",
    "build:release:verbose": "node server/build.js --release --verbose",
    "build:unity": "node server/build.js --unity",
    "build:unity:release": "node server/build.js --unity --release",
    "build:with-tests": "node server/build.js --tests",
    "start": "node server/server.js",
    "start:release": "node server/server.js --release",
    "start:unity": "node server/server.js --unity",
    "start:unity:release": "node server/server.js --unity --release",
    "test": "node server/build.js --tests --coverage && node server/coverage.js",
    "test:release": "node server/build.js --release --debug-symbols --tests --assertions --coverage && node server/coverage.js"
  }
}
